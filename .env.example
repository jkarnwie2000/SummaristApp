# Copy to .env.local and fill in. Never commit real keys.

# Stripe — https://dashboard.stripe.com/test/apikeys (use test keys while developing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or the webhook endpoint in the Stripe dashboard (event: payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin dashboard at /admin
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing the admin session cookie
ADMIN_SESSION_SECRET=

# Optional: store orders + inventory in Firestore instead of .data/store.json.
# Required on Vercel (its filesystem is read-only). Paste the service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_KEY=
