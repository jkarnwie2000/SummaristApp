# Copy to .env.local and fill in. Never commit real keys.

# Stripe — https://dashboard.stripe.com/test/apikeys (use test keys while developing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or the webhook endpoint in the Stripe dashboard (event: payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin dashboard at /admin
# Admins sign in with a Firebase email/password account (create one at /admin/signup).
# Only VERIFIED accounts whose email is listed here can open the dashboard.
ADMIN_EMAILS=you@example.com,partner@example.com
# Secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=

# Purchase emails (SMTP). Gmail: smtp.gmail.com, port 465, and an App Password
# (Google Account > Security > App passwords). Works with any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Summarist <you@gmail.com>"
# Every order is also emailed to these addresses (comma separated)
BUSINESS_EMAILS=you@example.com

# Optional: store orders + inventory in Firestore instead of .data/store.json.
# Required on Vercel (its filesystem is read-only). Paste the service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_KEY=
